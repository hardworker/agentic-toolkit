#!/usr/bin/env node
// cf-access-proxy — localhost HTTP fronts for Cloudflare Access apps.
//
// Injects a fresh `cf-access-token` on every proxied request, so a client that
// cannot refresh its own credential (an MCP server that snapshots header env at
// startup, say) stays authenticated indefinitely: point it at the local port and
// leave its code alone.
//
// Normally there is nothing to configure: the dynamic port takes the upstream from an
// `x-cf-access-upstream` header and allows any host matching a suffix in
// ~/.config/cloudflare-access/hosts. Optional fixed ports for clients that cannot send
// that header live in $CF_ACCESS_PROXY_CONFIG (default ~/.config/cloudflare-access/proxy),
// one `<port> <upstream-origin>` pair per line, plus an optional trailing `# label`.
//
// Tokens are minted by `cf-access`, cached until SKEW seconds before expiry, and
// refreshed once (single-flight, rate-limited) when a response still comes back as a
// Cloudflare login redirect.

'use strict';

const fs = require('fs');
const os = require('os');
const path = require('path');
const http = require('http');
const https = require('https');
const { execFile } = require('child_process');

const hosts = require('./cf-access-hosts.cjs');

const CONFIG =
  process.env.CF_ACCESS_PROXY_CONFIG || path.join(os.homedir(), '.config/cloudflare-access/proxy');
// Sibling, not the installer's bin dir: the two are installed side by side either way, so
// this keeps --bin-dir and hand-supervised (non-launchd) setups working without CF_ACCESS_BIN.
const CF_ACCESS = process.env.CF_ACCESS_BIN || path.join(__dirname, 'cf-access');
const SKEW = Number(process.env.CF_ACCESS_SKEW || 600);
const LOGIN_COOLDOWN = Number(process.env.CF_ACCESS_LOGIN_COOLDOWN || 60) * 1000;
// How long a request may wait for a token before it is answered anyway. Must stay under
// the client's own timeout (30s is the common MCP default) — the login keeps running in
// the background, so a retry lands on a token. 0 disables waiting entirely.
const HOLD = Number(process.env.CF_ACCESS_HOLD || 20) * 1000;
const LOGIN_DEADLINE = Number(process.env.CF_ACCESS_LOGIN_DEADLINE || 120) * 1000;

const log = (...a) => console.log(new Date().toISOString(), ...a);

// Quoted and bounded: anything as the user can reach the port and forge a line shaped like ours.
const q = (s, n = 128) => JSON.stringify(String(s ?? '').slice(0, n));

// The broker prints the SSO URL on failure; this log is world-readable and never rotated.
const redact = (s) => s.replace(/https:\/\/\S*\/cdn-cgi\/access\/cli\?\S*/g, '<sso-url redacted>');

// A fixed-port client sits on loopback and knows nothing about cf-access, so it can never name
// itself. The route is the only identity left.
const clientTag = (req, route) =>
  req.headers['x-cf-access-client']
    ? q(req.headers['x-cf-access-client'])
    : route || `peer :${req.socket.remotePort}`;

// Query strings carry signatures and tokens. `?…` distinguishes "none" from "withheld".
const routeOf = (url) => {
  const [route, query] = String(url ?? '').split('?');
  return q(route, 200) + (query === undefined ? '' : '?…');
};

// Never exits on a bad or missing config: under launchd's KeepAlive that would be a
// restart loop. It logs, keeps serving what it has, and reconciles when the file changes.
function readRoutes() {
  let text;
  try {
    text = fs.readFileSync(CONFIG, 'utf8');
  } catch {
    return []; // no static routes is the normal case: the dynamic port covers everything
  }

  const routes = [];
  for (const raw of text.split('\n')) {
    const [head, ...note] = raw.split('#');
    const line = head.trim();
    if (!line) continue;
    const [port, upstream] = line.split(/\s+/);
    if (!/^\d+$/.test(port || '') || !/^https?:\/\//.test(upstream || '')) {
      log(`ignoring malformed line: ${raw.trim()}`);
      continue;
    }
    const label = note.join('#').trim();
    const route = `fixed port ${port}${label ? ` (${q(label, 48)})` : ''}`;
    routes.push({ port: Number(port), upstream: new URL(upstream), route });
  }
  return routes;
}

const jwtExp = (jwt) => {
  try {
    const { exp } = JSON.parse(Buffer.from(jwt.split('.')[1], 'base64url').toString());
    return Number.isFinite(exp) ? exp : 0;
  } catch {
    return 0;
  }
};

// One token cache per app, so a stale-token stampede collapses into a single mint.
class TokenSource {
  constructor(app) {
    this.app = app;
    this.jwt = null;
    this.exp = 0;
    this.inflight = null;
    this.lastLogin = 0;
  }

  fresh() {
    return this.jwt && this.exp - Date.now() / 1000 > SKEW;
  }

  // Every browser window starts here, the one place that can name the cause. It fires *before*
  // the attempt: waiting for the mint would report it LOGIN_DEADLINE late, or never.
  mint(allowLogin, why = '', session = '') {
    const args = allowLogin ? ['token', this.app] : ['token', '--no-login', this.app];
    if (allowLogin) {
      log(`sso ${this.app} ${why}${session && ` session=${q(session, 64)}`}`);
    }
    return new Promise((resolve) => {
      let killer;
      let settled = false;
      const settle = (v) => {
        if (!settled) {
          settled = true;
          resolve(v);
        }
      };

      const env = {
        ...process.env,
        CF_ACCESS_TRACE: allowLogin ? why : '',
        CF_ACCESS_SESSION: allowLogin ? session : '',
      };
      const child = execFile(CF_ACCESS, args, { env }, (err, stdout, stderr) => {
        clearTimeout(killer);
        const jwt = (stdout || '').trim();
        if (err || !jwt.startsWith('ey')) {
          if (allowLogin) log(`token FAILED ${this.app}: ${redact((stderr || err?.message || '').trim())}`);
          settle(null);
          return;
        }
        this.jwt = jwt;
        this.exp = jwtExp(jwt);
        log(`token ok ${this.app} (${Math.round(this.exp - Date.now() / 1000)}s)`);
        settle(jwt); // a late success still lands in the cache, for the client's retry
      });

      // The deadline settles the promise itself rather than waiting for the child to die:
      // cloudflared ignores SIGTERM and holds the pipe open, which is how execFile's own
      // `timeout` once turned a login into a 9-minute hang. The kill is best-effort — and
      // `pkill -P`, because the grandchild is the process that hangs, not the sh wrapper.
      killer = setTimeout(() => {
        log(`token deadline ${this.app} — abandoning the mint`);
        try {
          child.kill('SIGKILL');
        } catch {}
        execFile('/usr/bin/pkill', ['-9', '-P', String(child.pid)], () => {});
        settle(null);
      }, allowLogin ? LOGIN_DEADLINE : 15_000);
    });
  }

  get({ force = false, holdMs = 0, why = '', session = '' } = {}) {
    if (!force && this.fresh()) return Promise.resolve(this.jwt);

    if (!this.inflight) {
      this.inflight = (async () => {
        // Always try the cheap read first: it reflects a token cloudflared refreshed
        // out of band, and never opens a browser.
        const local = await this.mint(false);
        if (local) return local;

        // Only an SSO round-trip is left. Rate-limited, because a burst of failing
        // requests would otherwise stack up browser tabs.
        if (Date.now() - this.lastLogin < LOGIN_COOLDOWN) return null;
        this.lastLogin = Date.now();
        return this.mint(true, why, session);
      })().finally(() => {
        this.inflight = null;
      });
    }

    if (!holdMs) return this.inflight;
    // Give up waiting without giving up the login: the mint keeps running for the retry.
    return Promise.race([
      this.inflight,
      new Promise((r) => setTimeout(() => r(null), holdMs).unref()),
    ]);
  }
}

const isAccessRedirect = (res) =>
  [301, 302, 303, 307, 308].includes(res.statusCode) &&
  /cdn-cgi\/access\/login/.test(res.headers.location || '');

const HOP_BY_HOP = new Set([
  'connection',
  'keep-alive',
  'proxy-authenticate',
  'proxy-authorization',
  'te',
  'trailer',
  'transfer-encoding',
  'upgrade',
  'host',
]);

function forward({ upstream, req, body, jwt }) {
  const agent = upstream.protocol === 'https:' ? https : http;
  const headers = {};
  // The whole `x-cf-access-` namespace, not the names known today: the next one added to the
  // preload would otherwise ship to the origin until the daemon was restarted. Filtering while
  // building beats deleting after, and the token is set only from `jwt` below.
  for (const [k, v] of Object.entries(req.headers)) {
    const lk = k.toLowerCase();
    if (!HOP_BY_HOP.has(lk) && !lk.startsWith('x-cf-access-') && lk !== 'cf-access-token') {
      headers[k] = v;
    }
  }
  headers.host = upstream.host;
  if (jwt) headers['cf-access-token'] = jwt;
  if (body) headers['content-length'] = String(body.length);

  return new Promise((resolve, reject) => {
    const out = agent.request(
      {
        protocol: upstream.protocol,
        host: upstream.hostname,
        port: upstream.port || (upstream.protocol === 'https:' ? 443 : 80),
        method: req.method,
        path: req.url,
        headers,
        servername: upstream.hostname,
      },
      resolve
    );
    out.on('error', reject);
    if (body) out.end(body);
    else out.end();
  });
}

// Token caches outlive listeners, so editing routes never costs a re-mint.
const tokenSources = new Map();
const tokenSourceFor = (origin) => {
  if (!tokenSources.has(origin)) tokenSources.set(origin, new TokenSource(origin));
  return tokenSources.get(origin);
};

// Whether an origin is behind Access is *learned*, never configured: the first request
// goes out bare, and only a Cloudflare login redirect proves a token is needed. So a
// host that isn't gated never triggers an SSO attempt, and a newly gated one starts
// getting tokens on its own.
const gating = new Map(); // origin -> "unknown" | "gated" | "open"

// A client that brings its own Access credential is already authenticated: a service
// token (the headless-friendly path), a token it minted itself, or a session cookie.
// Minting over that would replace working auth with an interactive login the client
// cannot perform — which is exactly how a service-token MCP server ends up blocked on a
// browser tab. Such requests are forwarded untouched, and never trigger SSO.
const carriesOwnCredential = (req) => {
  const h = req.headers;
  if (h['cf-access-token']) return true;
  if (h['cf-access-client-id'] && h['cf-access-client-secret']) return true;
  return /(^|;\s*)CF_Authorization=/.test(h.cookie || '');
};

const ownPorts = new Set();
const isSelf = (u) =>
  ['127.0.0.1', 'localhost', '::1'].includes(u.hostname) &&
  ownPorts.has(Number(u.port || (u.protocol === 'https:' ? 443 : 80)));

async function proxyRequest({ req, res, upstream, body, route }) {
  // Defence in depth against the loop above: refuse to forward to ourselves.
  if (isSelf(upstream)) {
    log(`loop refused: ${upstream.origin}`);
    res.writeHead(508, { 'content-type': 'text/plain' });
    res.end(`cf-access-proxy: ${upstream.origin} is this proxy\n`);
    return;
  }

  const origin = upstream.origin;

  if (carriesOwnCredential(req)) {
    const own = await forward({ upstream, req, body, jwt: req.headers['cf-access-token'] || null });
    if (!isAccessRedirect(own)) {
      res.writeHead(own.statusCode, own.headers);
      own.pipe(res);
      return;
    }
    // The credential exists but Access refused it (a service token missing from the
    // policy, say). Fall through to the broker rather than hand the client a login page.
    own.resume();
    log(`${origin}: client credential rejected by Access — falling back to the broker`);
  }

  const tokens = tokenSourceFor(origin);
  const state = gating.get(origin) || 'unknown';
  const why = `${req.method} ${routeOf(req.url)} ← ${clientTag(req, route)}`;
  // Raw, not quoted: this is compared against session records downstream, and q() would make it
  // match nothing. Quoted at the log boundary instead, where the injection risk actually is.
  const session = String(req.headers['x-cf-access-session'] || '').slice(0, 64);

  let jwt = state === 'gated' ? await tokens.get({ holdMs: HOLD, why, session }) : null;
  let upRes = await forward({ upstream, req, body, jwt });

  if (isAccessRedirect(upRes)) {
    if (state !== 'gated') {
      gating.set(origin, 'gated');
      log(`${origin} is Access-gated — minting a token`);
    } else {
      log(`stale token for ${origin} — refreshing`);
    }
    upRes.resume();
    jwt = await tokens.get({ force: state === 'gated', holdMs: HOLD, why, session });
    if (!jwt) {
      res.writeHead(511, { 'content-type': 'text/plain' });
      res.end(
        `cf-access-proxy: no token for ${origin} within ${HOLD / 1000}s\n` +
          `a login may still be finishing in the background — retry, or run: cf-access login ${origin}\n`
      );
      return;
    }
    upRes = await forward({ upstream, req, body, jwt });
  } else if (state === 'unknown') {
    gating.set(origin, jwt ? 'gated' : 'open');
  }

  res.writeHead(upRes.statusCode, upRes.headers);
  upRes.pipe(res);
}

// Bodies are buffered so a token retry can replay the request byte-for-byte.
const withBody = (handler) => (req, res) => {
  const chunks = [];
  req.on('data', (c) => chunks.push(c));
  req.on('end', async () => {
    try {
      await handler(req, res, chunks.length ? Buffer.concat(chunks) : null);
    } catch (err) {
      log(`proxy error ${req.method} ${routeOf(req.url)}: ${err.message}`);
      res.writeHead(502, { 'content-type': 'text/plain' });
      res.end(`cf-access-proxy: ${err.message}\n`);
    }
  });
};

function serve({ port, upstream, route }) {
  const server = http.createServer(
    withBody((req, res, body) => proxyRequest({ req, res, upstream, body, route }))
  );

  ownPorts.add(port);
  server.listen(port, '127.0.0.1', () =>
    log(`listening 127.0.0.1:${port} -> ${upstream.origin}`)
  );
  // A port already in use is that one route's problem; the rest keep serving.
  server.on('error', (err) => log(`${port} -> ${upstream.origin}: ${err.message}`));
  return server;
}

const active = new Map(); // "<route> -> origin" -> server

function reconcile() {
  // The route text is the key, so a renamed label restarts that listener. Caches key on origin.
  const wanted = new Map(readRoutes().map((r) => [`${r.route} -> ${r.upstream.origin}`, r]));

  for (const [key, server] of active) {
    if (!wanted.has(key)) {
      server.close();
      active.delete(key);
      log(`stopped ${key}`);
    }
  }
  for (const [key, route] of wanted) {
    if (!active.has(key)) active.set(key, serve(route));
  }
}

reconcile();
// watchFile, not watch: editors replace the file rather than writing in place, which
// breaks an inode-bound watcher. Polling keeps route edits live with no restart.
fs.watchFile(CONFIG, { interval: 2000 }, reconcile);

// ---- dynamic port: one listener for every host, no route entry required ----------
// Callers name the upstream in `x-cf-access-upstream` (cf-access-preload does this
// automatically), so a gated app that appears later needs no configuration at all.
// The suffix allowlist is what keeps this from being an open forwarder on loopback.

const { HOSTS_FILE, PORT: DYNAMIC_PORT } = hosts;

ownPorts.add(DYNAMIC_PORT);

http
  .createServer(
    withBody((req, res, body) => {
      const host = req.headers['x-cf-access-upstream'];
      const scheme = req.headers['x-cf-access-scheme'] === 'http' ? 'http' : 'https';

      if (!host) {
        res.writeHead(400, { 'content-type': 'text/plain' });
        res.end('cf-access-proxy: missing x-cf-access-upstream\n');
        return Promise.resolve();
      }
      if (!hosts.matches(host)) {
        log(`refused ${q(host)} (not in ${HOSTS_FILE})`);
        res.writeHead(403, { 'content-type': 'text/plain' });
        res.end(`cf-access-proxy: ${host} is not an allowed upstream\n`);
        return Promise.resolve();
      }

      return proxyRequest({ req, res, upstream: new URL(`${scheme}://${host}`), body });
    })
  )
  .listen(DYNAMIC_PORT, '127.0.0.1', () =>
    log(
      `listening 127.0.0.1:${DYNAMIC_PORT} -> allowed hosts (${hosts.suffixes().join(', ') || 'none configured'})`
    )
  )
  .on('error', (err) => log(`dynamic ${DYNAMIC_PORT}: ${err.message}`));
