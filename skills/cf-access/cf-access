#!/bin/sh
# cf-access — one place to get a Cloudflare Access JWT for any gated app.
#
# Access apps whose policy allows only an IdP (Google Workspace, Okta, …) have no
# service-token path, so a token can only come from a browser SSO round-trip.
# cloudflared keeps an org-wide session token, so the first login warms the org and
# every other app then mints silently — hence `cf-access login` with no args: one tap,
# all apps.
#
# Subcommands:
#   token [--no-login] <app>        print a valid JWT (refreshing if stale)
#   cookie <app>                    print "CF_Authorization=<jwt>"
#   env <app> <VAR> -- <cmd...>     export VAR=<jwt> and exec cmd (MCP launchers)
#   curl <url> [curl args...]       curl with the JWT header injected
#   login [<app>...]                refresh stale tokens (default: all configured)
#   list                            configured apps and remaining token lifetime
#   browser                         which browser command SSO will use
#
# Apps come from $CF_ACCESS_APPS_FILE (default ~/.config/cloudflare-access/apps).
#
# $CF_ACCESS_TRACE and $CF_ACCESS_SESSION are set by cf-access-proxy on the child it spawns, not
# by you. Absent from install.sh's TUNABLES, which carries launchd→daemon knobs only.
set -eu

APPS_FILE="${CF_ACCESS_APPS_FILE:-$HOME/.config/cloudflare-access/apps}"
BROWSER_FILE="${CF_ACCESS_BROWSER_FILE:-$HOME/.config/cloudflare-access/browser}"
SKEW="${CF_ACCESS_SKEW:-600}"                          # refresh when under this many seconds of life left
LOGIN_DEADLINE="${CF_ACCESS_LOGIN_DEADLINE:-120}"      # kill an unanswered browser SSO after this
case "$(uname -s)" in
  Darwin) PLATFORM_OPENER=open ;;
  *) PLATFORM_OPENER=xdg-open ;;
esac

# Read from a file, not just the env, so the daemon and an interactive shell agree on
# which browser opens SSO without the setting being plumbed into launchd as well.
[ -n "${CF_ACCESS_BROWSER:-}" ] ||
  CF_ACCESS_BROWSER=$(grep -vE '^[[:space:]]*(#|$)' "$BROWSER_FILE" 2>/dev/null | head -1 || true)

die() {
  echo "cf-access: $*" >&2
  exit 1
}

command -v cloudflared >/dev/null 2>&1 || die "cloudflared not installed (brew install cloudflared)"

# Origin only: cloudflared scopes tokens per hostname, and a path would miss the cache.
app_origin() {
  printf '%s' "$1" | sed -E 's#^(https?://[^/]+).*#\1#'
}

configured_apps() {
  [ -f "$APPS_FILE" ] || return 0
  sed -E 's/#.*//; s/[[:space:]]+//g' "$APPS_FILE" | grep -E '^https?://' || true
}

# One claim out of a JWT payload; empty when absent or unparseable. An array claim
# (`aud`) yields its first element.
# stdout.write, not console.log: console.log colorizes numbers under FORCE_COLOR,
# and the ANSI codes break the numeric tests downstream.
jwt_claim() {
  node -e '
    const p = (process.argv[2] || "").split(".")[1];
    if (!p) process.exit(0);
    try {
      const v = JSON.parse(Buffer.from(p, "base64url").toString())[process.argv[1]];
      process.stdout.write(String(Array.isArray(v) ? v[0] : (v ?? "")));
    } catch {}
  ' "$1" "$2" 2>/dev/null
}

# Seconds of life left in a JWT; -1 when absent or unparseable.
jwt_ttl() {
  exp=$(jwt_claim exp "$1")
  case "$exp" in
    '' | *[!0-9]*) echo -1 ;;
    *) echo $((exp - $(date +%s))) ;;
  esac
}

cached_token() {
  t=$(cloudflared access token -app="$1" 2>/dev/null || true)
  case "$t" in ey*) printf '%s' "$t" ;; esac
}

# "<app>|<profile-directory>" for whichever installed Chromium browser is signed in as
# an account. --profile-directory wants the directory name, which is opaque and unaffected
# by renaming the profile, so an account address is the stable way to name one.
# $CF_ACCESS_BROWSER_APPS overrides the search list: "App Name:support-dir" per line.
browser_profile() {
  node -e '
    const fs = require("fs");
    const want = String(process.argv[1] || "").toLowerCase();
    const apps = (process.env.CF_ACCESS_BROWSER_APPS || `
      Google Chrome:Google/Chrome
      Google Chrome Beta:Google/Chrome Beta
      Google Chrome Canary:Google/Chrome Canary
      Brave Browser:BraveSoftware/Brave-Browser
      Microsoft Edge:Microsoft Edge
      Vivaldi:Vivaldi
      Arc:Arc/User Data
    `)
      .split("\n").map((l) => l.trim()).filter(Boolean)
      .map((l) => [l.slice(0, l.lastIndexOf(":")).trim(), l.slice(l.lastIndexOf(":") + 1).trim()]);

    for (const [app, dir] of apps) {
      let cache;
      try {
        const state = `${process.env.HOME}/Library/Application Support/${dir}/Local State`;
        cache = JSON.parse(fs.readFileSync(state, "utf8")).profile?.info_cache || {};
      } catch { continue }
      for (const [profile, v] of Object.entries(cache)) {
        const who = (v.user_name || v.gaia_name || "").toLowerCase();
        if (who === want) { process.stdout.write(`${app}|${profile}`); process.exit(0) }
      }
    }
  ' "$1" 2>/dev/null
}

# An account address in place of a command means "the browser profile signed in as this".
# A browser preference must never break a login, so an unresolvable one warns and falls
# back to the platform opener.
resolve_browser() {
  case "${CF_ACCESS_BROWSER:-}" in
    '' | *' '*) return 0 ;;
    *@*)
      found=$(browser_profile "$CF_ACCESS_BROWSER")
      if [ -n "$found" ]; then
        CF_ACCESS_BROWSER="open -na \"${found%%|*}\" --args --profile-directory=\"${found#*|}\""
      else
        echo "cf-access: no browser profile signed in as $CF_ACCESS_BROWSER — using the default browser" >&2
        CF_ACCESS_BROWSER=
      fi
      ;;
  esac
}

# Cache files are named after the *app*, not the requested host — a host covered by a
# wildcard app (`*.example.com` lands in `-.example.com-<aud>-token`) would survive a
# host-name glob. The token's own `aud` claim identifies its file unambiguously.
token_cache_files() {
  t=$(cached_token "$1")
  [ -n "$t" ] || return 0
  aud=$(jwt_claim aud "$t")
  [ -n "$aud" ] || return 0
  ls "$HOME/.cloudflared/"*-"$aud"-token 2>/dev/null || true
}

# `cloudflared access login` hands back the cached app token if one exists, even seconds
# from expiry — so renewal means clearing the cache first. The token is stashed and put
# back if the login fails, otherwise a browser-less machine would lose a usable token.
do_login() {
  echo "cf-access: browser SSO for $1" >&2
  resolve_browser
  stash=$(mktemp -d)
  token_cache_files "$1" | while IFS= read -r f; do
    [ -n "$f" ] && [ -f "$f" ] && mv "$f" "$stash/" 2>/dev/null
  done

  # A login killed by a timeout must not swallow the token it set aside. The page shares the dir.
  cleanup() {
    if [ -d "$stash" ] && [ -z "$(cached_token "$1")" ]; then
      for f in "$stash"/*-token; do
        [ -f "$f" ] && mv "$f" "$HOME/.cloudflared/" 2>/dev/null
      done
    fi
    rm -rf "$stash"
  }
  trap 'cleanup "$1"' EXIT INT TERM

  # cloudflared has no --no-browser, but when it cannot exec an opener it prints the login
  # URL and waits for the callback. Hiding the opener from it therefore buys two things:
  # the URL gets reported (the only fallback when no browser appears), and
  # $CF_ACCESS_BROWSER decides which browser or profile receives it.
  # cloudflared takes a lock per app plus one for the org token and leaves it behind when killed —
  # which the deadline below does. A stale lock makes every later login block silently and forever
  # (measured: 63s, no output, no browser), and the org one wedges every app at once. With no login
  # running, any lock is stale, so clearing them here self-heals a machine already wedged by an
  # abandoned login.
  # ponytail: skipped while another login holds a lock legitimately; the next attempt clears it.
  pgrep -f 'cloudflared access login' >/dev/null 2>&1 ||
    rm -f "$HOME"/.cloudflared/*.lock 2>/dev/null ||
    true

  cfd=$(command -v cloudflared)
  out=$(mktemp)
  PATH=/var/empty "$cfd" access login "$1" --quiet --auto-close >"$out" 2>&1 &
  cfd_pid=$!

  i=0
  url=
  while [ $i -lt 100 ]; do
    url=$(grep -oE 'https://[^[:space:]]+/cdn-cgi/access/cli\?[^[:space:]]+' "$out" | head -1)
    [ -n "$url" ] && break
    kill -0 "$cfd_pid" 2>/dev/null || break
    i=$((i + 1))
    sleep 0.1
  done

  # No url means cloudflared never offered one — usually the app is unreachable. Say so, or the
  # caller waits out the deadline with nothing on screen and nothing in the log.
  if [ -z "$url" ]; then
    echo "cf-access: cloudflared printed no login url — no browser will open; is $1 reachable?" >&2
  fi

  if [ -n "$url" ]; then
    echo "cf-access: if no browser opens, log in here:" >&2
    echo "  $url" >&2
    # A window nobody asked for gets a page naming its cause. Not an iframe: the IdP sends
    # X-Frame-Options: DENY.
    target=$url
    # ponytail: "has a trace" stands in for "nobody asked for this", true only while the proxy is
    # the sole producer — add `[ ! -t 2 ]` once another caller sets one.
    if [ -n "${CF_ACCESS_TRACE:-}" ]; then
      # Quoted heredoc, so this is ordinary JS, not JS escaped for sh.
      cat >"$stash/page.cjs" <<'PAGE'
const fs = require('fs');
const os = require('os');
const path = require('path');
const [out, url, trace, app, sessionId] = process.argv.slice(2);

const esc = (s) =>
  String(s).replace(/[&<>"']/g, (c) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  })[c]);

// A uuid names nothing to a human. Desktop record first, else the CLI's derived name. Here, not
// in the preload, which every Node process would pay for. Another product's private layout —
// session-migration/ccd_sessions.py reads the same tree.
// ponytail: reads every record; a keyed lookup pays off at thousands.
const newest = (dir, match, stamp, field) => {
  let best = null;
  try {
    const walk = (d) => {
      for (const e of fs.readdirSync(d, { withFileTypes: true })) {
        const p = path.join(d, e.name);
        if (e.isDirectory()) walk(p);
        else if (e.name.endsWith('.json')) {
          try {
            const o = JSON.parse(fs.readFileSync(p, 'utf8'));
            if (match(o) && o[field] && (!best || (o[stamp] || 0) > (best[stamp] || 0))) best = o;
          } catch {}
        }
      }
    };
    walk(dir);
  } catch {}
  return best ? String(best[field]) : '';
};

const home = os.homedir();
// Account-scoped and nested per org, hence the walk; a switched account still resolves.
const sessionName = !sessionId
  ? ''
  : newest(
      path.join(home, 'Library/Application Support/Claude/claude-code-sessions'),
      (o) => o.cliSessionId === sessionId,
      'lastActivityAt',
      'title'
    ) ||
    // A resumed session writes a second record under its new pid; newest wins.
    newest(path.join(home, '.claude/sessions'), (o) => o.sessionId === sessionId, 'startedAt', 'name');

fs.writeFileSync(out, `<!doctype html><meta charset="utf-8">
<title>cf-access: sign-in needed</title>
<style>
  :root { color-scheme: light dark }
  body { font: 15px/1.6 system-ui, sans-serif; max-width: 34rem; margin: 12vh auto; padding: 0 1.5rem }
  h1 { font-size: 1.25rem; margin: 0 0 1.5rem }
  dt { font-size: .75rem; text-transform: uppercase; letter-spacing: .05em; opacity: .6; margin-top: 1rem }
  dd { margin: .15rem 0 0; font-family: ui-monospace, monospace; font-size: .85rem; word-break: break-all }
  dd.name { font-family: inherit; font-size: 1rem; font-weight: 600 }
  a.go { display: inline-block; margin-top: 2rem; padding: .7rem 1.4rem; border-radius: .5rem;
         background: light-dark(#1a1a1a, #f0f0f0); color: light-dark(#fff, #111); text-decoration: none; font-weight: 600 }
  p.note { margin-top: 2rem; font-size: .8rem; opacity: .6 }
</style>
<h1>Something needs you to sign in.</h1>
<dl>
  <dt>Application</dt><dd>${esc(app)}</dd>
  ${sessionName ? `<dt>Session</dt><dd class="name">${esc(sessionName)}</dd>` : ''}
  <dt>Triggered by</dt><dd>${esc(trace)}${sessionName ? '' : esc(sessionId ? ` session=${sessionId}` : '')}</dd>
</dl>
<a class="go" href="${esc(url)}">Continue to sign-in</a>
<p class="note">Opened by cf-access. If this was not something you expected, close this tab &mdash;
nothing is signed in until you continue.</p>
`);
PAGE
      if node "$stash/page.cjs" "$stash/sso.html" "$url" "$CF_ACCESS_TRACE" "$1" \
        "${CF_ACCESS_SESSION:-}" 2>/dev/null; then
        target="file://$stash/sso.html"
      fi
    fi
    eval "${CF_ACCESS_BROWSER:-$PLATFORM_OPENER} \"\$target\"" >/dev/null 2>&1 || true
  fi

  # cloudflared waits for the SSO callback forever, so a login nobody completes would hang
  # its caller for good — a shell, or an MCP launcher via `cf-access env`. The bound lives
  # here, where every caller routes through, rather than in one caller. SIGKILL and
  # `pkill -P`: cloudflared ignores SIGTERM, and the grandchild is what holds the pipe.
  deadline=$(($(date +%s) + LOGIN_DEADLINE))
  while kill -0 "$cfd_pid" 2>/dev/null; do
    if [ "$(date +%s)" -ge "$deadline" ]; then
      echo "cf-access: no login within ${LOGIN_DEADLINE}s — abandoning $1" >&2
      pkill -9 -P "$cfd_pid" 2>/dev/null || true
      kill -9 "$cfd_pid" 2>/dev/null || true
      break
    fi
    sleep 0.5
  done
  wait "$cfd_pid" 2>/dev/null || true
  rm -f "$out"

  cleanup "$1"
  trap - EXIT INT TERM
}

# Valid JWT for an app, refreshing when stale unless --no-login.
get_token() {
  allow_login=$1
  app=$(app_origin "$2")

  t=$(cached_token "$app")
  ttl=-1
  [ -z "$t" ] || ttl=$(jwt_ttl "$t")
  if [ "$ttl" -lt "$SKEW" ]; then
    [ "$allow_login" = yes ] || return 1
    do_login "$app"
    t=$(cached_token "$app")
    ttl=-1
    [ -z "$t" ] || ttl=$(jwt_ttl "$t")
  fi

  [ "$ttl" -gt 0 ] || return 1
  printf '%s' "$t"
}

cmd=${1:-}
[ -n "$cmd" ] || die "usage: cf-access {token|cookie|env|curl|login|list} ..."
shift

case "$cmd" in
token)
  allow_login=yes
  [ "${1:-}" = --no-login ] && {
    allow_login=no
    shift
  }
  [ $# -ge 1 ] || die "usage: cf-access token [--no-login] <app-url>"
  get_token "$allow_login" "$1" || die "no valid token for $1 (try: cf-access login $1)"
  echo
  ;;

cookie)
  [ $# -ge 1 ] || die "usage: cf-access cookie <app-url>"
  t=$(get_token yes "$1") || die "no valid token for $1"
  echo "CF_Authorization=$t"
  ;;

env)
  [ $# -ge 4 ] || die "usage: cf-access env <app-url> <VAR> -- <cmd...>"
  app=$1
  var=$2
  shift 2
  [ "$1" = -- ] || die "expected -- before the command"
  shift
  t=$(get_token yes "$app") || die "no valid token for $app (try: cf-access login $app)"
  # env(1), not export: header-name vars often need literal hyphens
  # (SOMETOOL_HEADER_cf-access-token), which are not valid shell identifiers.
  exec env "$var=$t" "$@"
  ;;

curl)
  [ $# -ge 1 ] || die "usage: cf-access curl <url> [curl args...]"
  url=$1
  shift
  t=$(get_token yes "$url") || die "no valid token for $url"
  exec curl -H "cf-access-token: $t" "$url" "$@"
  ;;

login)
  apps=$*
  [ -n "$apps" ] || apps=$(configured_apps)
  [ -n "$apps" ] || die "no apps given and none configured in $APPS_FILE"
  for app in $apps; do
    app=$(app_origin "$app")
    t=$(cached_token "$app")
    ttl=$(jwt_ttl "$t")
    if [ "$ttl" -ge "$SKEW" ]; then
      echo "ok       $app (${ttl}s left)"
      continue
    fi
    do_login "$app"
    t=$(cached_token "$app")
    ttl=$(jwt_ttl "$t")
    if [ "$ttl" -gt 0 ]; then echo "refreshed $app (${ttl}s)"; else echo "FAILED   $app"; fi
  done
  ;;

browser)
  resolve_browser
  echo "${CF_ACCESS_BROWSER:-<default browser>}"
  ;;

list)
  apps=$(configured_apps)
  [ -n "$apps" ] || die "no apps configured in $APPS_FILE"
  for app in $apps; do
    ttl=$(jwt_ttl "$(cached_token "$app")")
    if [ "$ttl" -gt 0 ]; then
      printf '%-40s %sh %sm left\n' "$app" "$((ttl / 3600))" "$(((ttl % 3600) / 60))"
    else
      printf '%-40s no token\n' "$app"
    fi
  done
  ;;

*) die "unknown subcommand: $cmd" ;;
esac
